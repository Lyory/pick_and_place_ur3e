# Cau hinh LLM: sua file nay sau khi clone, khong can export trong terminal.
# Ket noi provider (va nhap key/dang nhap provider) tai dashboard 9Router:
# http://127.0.0.1:20128/dashboard

# ID model day du trong 9Router, gom tien to provider neu co.
# Gia tri hien tai dung provider Antigravity (ag); doi neu ban dung model khac.
ROBOT_LLM_MODEL=ag/gemini-3.8-flash

# Thay abcxyz bang API key DO 9ROUTER TAO trong dashboard.
# API key cua provider duoc dien trong dashboard, khong dien vao dong nay.
# Khi commit/push, doi key that lai thanh abcxyz.
NINEROUTER_API_KEY=abcxyz

# Dia chi 9Router tren may ban; giu nguyen neu dung cong 20128.
ROBOT_LLM_BASE_URL=http://127.0.0.1:20128/v1
