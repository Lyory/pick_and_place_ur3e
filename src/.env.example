# Copy this file to .env in the same directory, then fill in your own settings.
# Connect your provider in http://127.0.0.1:20128/dashboard first.
# Full model ID from 9Router (including the provider prefix if shown).
ROBOT_LLM_MODEL=
# API key generated by 9Router; provider credentials belong in its dashboard.
NINEROUTER_API_KEY=
# Local OpenAI-compatible endpoint; change this if your 9Router uses another port.
ROBOT_LLM_BASE_URL=http://127.0.0.1:20128/v1
